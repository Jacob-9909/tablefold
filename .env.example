# ==========================================
# Tablefold & T2SQL Engine Environment Variables Template
# ==========================================

# 1. OpenAI / LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# 2. Database Connection (Docker / Live DB)
# Standard DSN (PostgreSQL, MSSQL, SQLite)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tablefold_db

# MSSQL Docker Container Connection Settings (used by demo/live.py)
TABLEFOLD_MSSQL_HOST=localhost
TABLEFOLD_MSSQL_PORT=1433
TABLEFOLD_MSSQL_USER=sa
TABLEFOLD_MSSQL_PASSWORD=YourPassword123!
TABLEFOLD_MSSQL_DB=SD_DM
